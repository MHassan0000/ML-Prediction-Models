# =============================================================
# ML Assignment 2 – Environment Variables
# =============================================================
# Copy this file to  .env  and fill in your actual values.
# The app will load these automatically via python-dotenv.
#
# NOTE: Never commit the real .env file to GitHub.
#       Only commit this .env.example file.
# =============================================================

# ── Streamlit Cloud deployment URLs ───────────────────────────
TITANIC_APP_URL=https://titanic-model-hassan.streamlit.app
HEART_DISEASE_APP_URL=https://heart-disease-model-hassan.streamlit.app

# ── Modal deployment URLs ─────────────────────────────────────
MODAL_TITANIC_URL=https://mhassan0000--titanic-predictor-run.modal.run
MODAL_HEART_URL=https://mhassan0000--heart-disease-predictor-run.modal.run

# ── Optional: Streamlit theme override (light | dark) ─────────
STREAMLIT_THEME=dark

# ── Optional: App password (if you add auth later) ────────────
# APP_SECRET_KEY=your-secret-key-here
