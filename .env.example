# =============================================================
# ML Assignment 2 – Environment Variables
# =============================================================
# Copy this file to  .env  and fill in your actual values.
# The app will load these automatically via python-dotenv.
#
# NOTE: Never commit the real .env file to GitHub.
#       Only commit this .env.example file.
# =============================================================

# ── Streamlit Cloud deployment URLs (fill after deploying) ────
TITANIC_APP_URL=
HEART_DISEASE_APP_URL=

# ── Optional: Streamlit theme override (light | dark) ─────────
STREAMLIT_THEME=dark

# ── Optional: App password (if you add auth later) ────────────
# APP_SECRET_KEY=your-secret-key-here
